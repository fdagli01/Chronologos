{
  "name": "chronologos",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "db:seed": "node server/seed.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "npm run build -- --configLoader native && electron .",
    "desktop:dir": "npm run build -- --configLoader native && electron-builder --win dir",
    "desktop:installer": "npm run build -- --configLoader native && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "d3-geo": "3.1.1",
    "postprocessing": "6.37.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.1.13",
    "vite": "6.4.3"
  },
  "main": "electron/main.mjs",
  "productName": "Chronologos",
  "build": {
    "appId": "com.chronologos.desktop",
    "productName": "Chronologos",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/**"
        ]
      },
      {
        "from": "electron/server-package.json",
        "to": "server/package.json"
      }
    ],
    "asar": true,
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chronologos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Chronologos",
      "runAfterFinish": true
    }
  },
  "description": "Kişisel düşünceler, kitaplar ve notlar için yaşayan bir atlas."
}
